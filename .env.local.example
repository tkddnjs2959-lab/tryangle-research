# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 걸려 있어 커밋되지 않습니다.
#
# 값 찾는 곳:
#   https://supabase.com/dashboard/project/xvpqjawckzdkzkohhbdg/settings/api

SUPABASE_URL=https://xvpqjawckzdkzkohhbdg.supabase.co

# service_role 키. 이 키는 RLS 를 우회하는 마스터 키입니다.
# 서버에서만 쓰이며 브라우저로 절대 나가지 않습니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 붙이면 브라우저에 노출됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 어드민 로그인 비밀번호. 직접 정해서 넣으세요.
ADMIN_PASSWORD=

# 응답 쿠키 서명용. 아무 긴 랜덤 문자열이면 됩니다.
SESSION_SECRET=

# 배우용 카카오 로그인
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# Kakao Developers > 카카오 로그인 > Redirect URI에 아래 주소를 등록하세요.
# 운영: https://app.tryangle-official.co.kr/api/actor/kakao/callback
# 로컬: http://localhost:3000/api/actor/kakao/callback
# 비워두면 현재 접속 origin 기준 /api/actor/kakao/callback 을 사용합니다.
KAKAO_ACTOR_REDIRECT_URI=

# 카카오 REST API Client Secret을 ON으로 둔 경우에만 입력하세요.
KAKAO_CLIENT_SECRET=

# ---------------------------------------------------------------------
# 주차 공개 알림 (선택)
# ---------------------------------------------------------------------
# 주차를 공개할 때 배우 카카오톡('나와의 채팅')으로 알림을 보내려면 켭니다.
# 건당 비용은 없지만 배우가 로그인할 때 메시지 동의를 해야 합니다.
#
# 켜는 순서 — 순서를 지키지 않으면 배우 로그인이 막힙니다:
#   1. Kakao Developers > 카카오 로그인 > 동의항목 에서
#      '카카오톡 메시지 전송(talk_message)' 을 사용 설정
#   2. 그 다음에 아래 값을 talk_message 로 채우기
#   3. 이미 로그인한 배우는 진행 현황 링크에서 다시 로그인해야
#      메시지 동의가 추가됩니다 (기존 배우는 알림이 안 갑니다)
#
# 비워두면 알림 없이 지금처럼 로그인만 동작합니다.
KAKAO_ACTOR_SCOPES=

# 알림 메시지에 넣을 진행 현황 링크의 도메인 (예: https://app.tryangle-official.co.kr)
# 비워두면 링크 없이 텍스트만 보냅니다.
# 넣으려면 Kakao Developers > 앱 설정 > 플랫폼 > Web 에도 같은 도메인을 등록해야 합니다.
PUBLIC_BASE_URL=
